<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 폰트 크기: 여기서만 관리. 각 화면/스타일은 아래 키를 참조한다. -->
    <sys:Double x:Key="FontSize14">14</sys:Double>
    <sys:Double x:Key="FontSize16">16</sys:Double>
    <sys:Double x:Key="FontSize18">18</sys:Double>
    <sys:Double x:Key="FontSize20">20</sys:Double>
    <sys:Double x:Key="FontSize22">22</sys:Double>
    <sys:Double x:Key="FontSize26">26</sys:Double>

    <!-- 팔레트: 다크 올리브 톤 + 화이트 카드 + 다크 로그 패널 -->
    <Color x:Key="OliveDarkColor">#3F4A2E</Color>
    <Color x:Key="OliveMidColor">#4B5836</Color>
    <Color x:Key="OliveAccentColor">#6B7A3A</Color>
    <Color x:Key="OliveAccentDarkColor">#556025</Color>
    <Color x:Key="OwlSilhouetteColor">#4E5C39</Color>
    <Color x:Key="CardWhiteColor">#F6F6F1</Color>
    <Color x:Key="LogPanelColor">#15181C</Color>
    <Color x:Key="TextDarkColor">#22261A</Color>
    <Color x:Key="TextMutedColor">#6E7360</Color>
    <Color x:Key="DangerRedColor">#C0392B</Color>
    <Color x:Key="DangerRedDarkColor">#96291E</Color>
    <Color x:Key="WarningYellowColor">#E4952B</Color>
    <Color x:Key="SuccessGreenColor">#4E9A4E</Color>
    <Color x:Key="LedOffColor">#555A48</Color>

    <SolidColorBrush x:Key="OliveDarkBrush" Color="{StaticResource OliveDarkColor}"/>
    <SolidColorBrush x:Key="OliveMidBrush" Color="{StaticResource OliveMidColor}"/>
    <SolidColorBrush x:Key="OliveAccentBrush" Color="{StaticResource OliveAccentColor}"/>
    <SolidColorBrush x:Key="OliveAccentDarkBrush" Color="{StaticResource OliveAccentDarkColor}"/>
    <SolidColorBrush x:Key="OwlSilhouetteBrush" Color="{StaticResource OwlSilhouetteColor}"/>
    <!-- 메인 화면 배경: 국방색 대각선 그라디언트 -->
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2C331F" Offset="0"/>
        <GradientStop Color="{StaticResource OliveDarkColor}" Offset="0.55"/>
        <GradientStop Color="{StaticResource OliveMidColor}" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardWhiteBrush" Color="{StaticResource CardWhiteColor}"/>
    <SolidColorBrush x:Key="LogPanelBrush" Color="{StaticResource LogPanelColor}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}"/>
    <SolidColorBrush x:Key="DangerRedDarkBrush" Color="{StaticResource DangerRedDarkColor}"/>
    <SolidColorBrush x:Key="WarningYellowBrush" Color="{StaticResource WarningYellowColor}"/>
    <SolidColorBrush x:Key="SuccessGreenBrush" Color="{StaticResource SuccessGreenColor}"/>
    <SolidColorBrush x:Key="LedOffBrush" Color="{StaticResource LedOffColor}"/>

    <!-- LED 표시등 -->
    <Style x:Key="LedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Stroke" Value="#20000000"/>
        <Setter Property="StrokeThickness" Value="1"/>
    </Style>

    <!-- 기본 텍스트 입력 -->
    <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#28000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize16}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- placeholder(안내 문구)를 지원하는 TextBox. Tag에 안내 문구를 넣어 사용한다. -->
    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FieldTextBoxStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                       Foreground="#9AA08C" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FieldPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="BorderBrush" Value="#28000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize16}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize14}"/>
        <Setter Property="Margin" Value="2,0,0,5"/>
    </Style>

    <!-- 올리브 톤 기본 버튼(전체 너비 등 꽉 채우는 CTA용) -->
    <Style x:Key="OliveButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource OliveDarkBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize16}"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource OliveAccentDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 아웃라인 버튼 공통 템플릿: Background/Foreground/BorderBrush만 바꿔서 사용 -->
    <Style x:Key="OutlineButtonBaseStyle" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize18}"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 사격 버튼: 화이트 배경 + 빨간 테두리/텍스트(아웃라인) -->
    <Style x:Key="FireOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource DangerRedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerRedBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FDF0EE"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 중단 버튼: 화이트 배경 + 회색/검정 테두리/텍스트(아웃라인) -->
    <Style x:Key="CeaseOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource OutlineButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource TextDarkBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0F0EE"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 설정(톱니바퀴) 아이콘 버튼: 평소엔 은은하게, 호버 시에만 살짝 강조 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize20}"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="20">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#14000000"/>
                <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 카드형 패널 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardWhiteBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
